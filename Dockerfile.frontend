

# Use Node.js 20 as base image
FROM node:20-alpine

# Install pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

# Set working directory
WORKDIR /app

# Copy package files
COPY newfrontend/package.json newfrontend/pnpm-lock.yaml ./

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy all source files except node_modules (handled by .dockerignore)
COPY newfrontend/*.* ./
COPY newfrontend/src ./src

# Build the application
RUN pnpm run build

# Expose port
EXPOSE 4173

# Start the server with host binding to 0.0.0.0
CMD ["pnpm", "run", "preview", "--host", "0.0.0.0", "--port", "4173"]