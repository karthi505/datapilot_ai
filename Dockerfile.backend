# Use Node.js 20 as base image
FROM node:20-alpine

# Set working directory
WORKDIR /app

# Copy package files
COPY backend/package*.json ./
COPY backend/pnpm-lock.yaml ./

# Install pnpm and dependencies
RUN npm install -g pnpm tsx && pnpm install --frozen-lockfile

# Set dummy DATABASE_URL for build time (required by prisma.config.ts)
ENV DATABASE_URL="postgresql://dummy:dummy@localhost:5432/dummy"

# Copy prisma files
COPY backend/prisma ./prisma
COPY backend/prisma.config.ts ./

# Generate Prisma client
RUN pnpm prisma generate

# Copy source code
COPY backend/src ./src

# Expose port
EXPOSE 5050

# Run migrations and start server (using tsx because Prisma client is TypeScript)
CMD ["sh", "-c", "pnpm prisma migrate deploy && pnpm tsx src/server.js"]